@Remy.Api_HostAddress = http://localhost:5163

# When verification is enabled, set this to TelegramWebhook__SecretToken.
@TelegramWebhook_SecretToken =

POST {{Remy.Api_HostAddress}}/Bot/Webhook
Content-Type: application/json
X-Telegram-Bot-Api-Secret-Token: {{TelegramWebhook_SecretToken}}

{
  "update_id": 10001,
  "message": {
    "message_id": 1,
    "date": 1789344000,
    "from": {
      "id": 123456789,
      "is_bot": false,
      "first_name": "Test"
    },
    "chat": {
      "id": 123456789,
      "type": "private"
    },
    "text": "/start"
  }
}

###

POST {{Remy.Api_HostAddress}}/Bot/Webhook
Content-Type: application/json
X-Telegram-Bot-Api-Secret-Token: {{TelegramWebhook_SecretToken}}

{
  "update_id": 10002,
  "callback_query": {
    "id": "callback-1",
    "from": {
      "id": 123456789,
      "is_bot": false,
      "first_name": "Test"
    },
    "chat_instance": "1234567890123456789",
    "inline_message_id": "inline-message-1",
    "data": "example"
  }
}

